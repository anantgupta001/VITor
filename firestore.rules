rules_version = '2';

// ===============================================================
// Assumed Data Models & Schema Documentation
// ===============================================================
//
// 1. User Profiles Collection: /users/{userId}
//    - Document ID: userId (matches Firebase Auth UID)
//    - Fields:
//      * campusSlug: string (required, allowed: ['vit-ap', 'vit-v', 'vit-c', 'vit-b'])
//    - Identity & Domain Mapping:
//      * @vitstudent.ac.in -> campusSlug in ['vit-v', 'vit-c']
//      * @vitapstudent.ac.in -> campusSlug == 'vit-ap'
//      * @vitbhopal.ac.in -> campusSlug == 'vit-b'
//    - Allowed keys: ['campusSlug'] strictly.
//    - Access: Owner-only read, create, and update. Profile deletion denied.
//
// 2. Faculties Collection: /campuses/{campusSlug}/faculties/{facultyId}
//    - Document ID: facultyId (faculty identifier)
//    - Fields: Managed directory (name, department, email, avgRating, reviewCount, etc.)
//    - Access: Public read for valid campuses. Direct client create/update/delete denied.
//
// 3. Reviews Subcollection: /campuses/{campusSlug}/faculties/{facultyId}/reviews/{userId}
//    - Document ID: userId (reviewer UID matching Firebase Auth UID)
//    - Fields: Server-managed review record (userId, ratings, comment, status, shardId, version, timestamps, etc.)
//    - Access: Public read for valid campuses. Direct client create/update/delete denied.
//      All review submissions, updates, and moderation are mediated via server APIs using Admin SDK.
//
// 4. Shards Subcollection: /campuses/{campusSlug}/faculties/{facultyId}/shards/{shardId}
//    - Document ID: shardId (string '0'..'4')
//    - Fields: Sharded counters (reviewCount, rating sums, updatedAt, schemeVersion)
//    - Access: Public read for valid campuses. Direct client create/update/delete denied.
//
// 5. Request Receipts Collection: /campuses/{campusSlug}/requestReceipts/{receiptId}
//    - Document ID: receiptId (idempotency key)
//    - Fields: Server idempotency receipts (idempotencyKey, payloadHash, statusCode, responseBody, etc.)
//    - Access: Direct client read and write denied completely.
//
// 6. User Rate Limits Subcollection: /campuses/{campusSlug}/users/{userId}/rateLimits/{document=**}
//    - Document ID: rate limit document (e.g. 'reviewQuota')
//    - Fields: Server rate-limiting tracking (timestamps, count, updatedAt)
//    - Access: Direct client read and write denied completely.
//
// 7. System Collection: /system/{docId}
//    - Document ID: docId (e.g. 'reviewMaintenance')
//    - Fields: System status (status: 'OPEN' | 'CLOSING' | 'CLOSED', updatedAt, metadata)
//    - Access: Public read permitted. Direct client write denied completely.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is the resource owner by UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate recognized campus slugs
    function isValidCampus(campusSlug) {
      return campusSlug in ['vit-ap', 'vit-v', 'vit-c', 'vit-b'];
    }

    // Verify VIT student email domains from authenticated token
    function hasVitStudentEmail() {
      return isAuthenticated() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.matches('.*@vitstudent[.]ac[.]in$');
    }

    function hasVitApEmail() {
      return isAuthenticated() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.matches('.*@vitapstudent[.]ac[.]in$');
    }

    function hasVitBhopalEmail() {
      return isAuthenticated() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.matches('.*@vitbhopal[.]ac[.]in$');
    }

    // ===============================================================
    // Domain Validators (Used for both Create and Update)
    // ===============================================================

    // Validator for User Profile documents (/users/{userId})
    function isValidUserProfile(data) {
      return data.keys().hasOnly(['campusSlug']) &&
        ('campusSlug' in data) &&
        data.campusSlug is string &&
        isValidCampus(data.campusSlug) &&
        (
          (hasVitStudentEmail() && data.campusSlug in ['vit-v', 'vit-c']) ||
          (hasVitApEmail() && data.campusSlug == 'vit-ap') ||
          (hasVitBhopalEmail() && data.campusSlug == 'vit-b')
        );
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // 1. User profile documents (stores campus selection for Vellore/Chennai)
    match /users/{userId} {
      // Users can only read their own profile
      allow read: if isOwner(userId);

      // Authenticated owners can create and update their profile with strict domain bounds
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);

      // User profile deletion is disallowed
      allow delete: if false;
    }

    // 2. Campus Scoped Documents & Subcollections
    match /campuses/{campusSlug} {
      // Faculty directory under each campus
      match /faculties/{facultyId} {
        // Public read restricted to valid campuses
        allow read: if isValidCampus(campusSlug);

        // Client direct creation, update, and deletion are denied
        allow create, update, delete: if false;

        // Faculty reviews subcollection (managed entirely by server transactions)
        match /reviews/{userId} {
          // Public read restricted to valid campuses
          allow read: if isValidCampus(campusSlug);

          // Direct client creation, update, and deletion are denied
          allow create, update, delete: if false;
        }

        // Aggregate counter shards
        match /shards/{shardId} {
          // Public read restricted to valid campuses
          allow read: if isValidCampus(campusSlug);

          // Direct client creation, update, and deletion are denied
          allow create, update, delete: if false;
        }
      }

      // Idempotency request receipts - server-only access
      match /requestReceipts/{receiptId} {
        allow read, write: if false;
      }

      // Rate limit quotas - server-only access
      match /users/{userId}/rateLimits/{document=**} {
        allow read, write: if false;
      }
    }

    // 3. System Configuration & Maintenance Gate
    match /system/{docId} {
      // Public read permitted for maintenance gate status checks
      allow read: if true;

      // Direct client creation, update, and deletion are denied
      allow write: if false;
    }

    // ===============================================================
    // Default Deny Rule for Undeclared Collections
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
