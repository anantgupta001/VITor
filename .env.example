# VITor environment variables — copy to .env.local and fill in. Names + placeholders only.
# NEVER commit real values. Only NEXT_PUBLIC_* values are shipped to browsers.

# ── Firebase web config (public by design; protected by Auth/rules/App Check) ──
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# reCAPTCHA Enterprise SITE key (public) used by Firebase App Check
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=your-recaptcha-enterprise-site-key

# ── Server-only (do NOT prefix with NEXT_PUBLIC_) ──
FIREBASE_PROJECT_ID=your-project-id
# Firebase Admin credentials — choose ONE:
#  a) Application Default Credentials / workload identity (preferred on GCP): set nothing.
#  b) Path to a service-account JSON kept OUTSIDE the repository (local dev):
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
#  c) Host-managed secrets (e.g. Vercel env vars):
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}   # single-line JSON
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Secret for encrypting review pagination cursors. REQUIRED, >= 32 bytes of randomness.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CURSOR_SECRET=replace-with-at-least-32-random-bytes

# Comma-separated emails allowed to use /api/reviews/moderate (in addition to custom claims)
ADMIN_EMAILS=admin@example.com

# Build-time: set to "enforce" to switch the CSP from report-only to enforcing
# CSP_MODE=enforce

# ── Local development / tests only (ignored or rejected in production) ──
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8086
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9098
# Client-side App Check is skipped on localhost; no debug token is used.
# REQUIRE_APP_CHECK=true              # force App Check checks outside production
# DISABLE_APP_CHECK_FOR_TESTS=true     # never honoured when NODE_ENV=production

# ── Backup scripts (scripts/gcloud-backup-firestore.mjs) ──
# VITOR_BACKUP_PROJECT_ID=your-project-id
# VITOR_BACKUP_BUCKET=your-backup-bucket
# VITOR_BACKUP_DATABASE=(default)
# VITOR_BACKUP_PREFIX=firestore-backups
